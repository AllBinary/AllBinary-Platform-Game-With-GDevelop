    <artifactId>GDGameThreedAndroidJavaLibraryKt</artifactId>
    <packaging>jar</packaging>

    <name>GDGameThreedAndroidJavaLibraryKt</name>
    <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
