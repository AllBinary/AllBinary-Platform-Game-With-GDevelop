plugins {
    id 'com.android.application'
}

android {
    compileSdkVersion 37
    buildToolsVersion = "37.0.0"

    defaultConfig {
        //needs template
        applicationId "org.allbinary.game.gd.threed.<name>"
        minSdkVersion 4
        targetSdkVersion 37
        versionCode 2
        versionName "0.0.2100"

        //testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
    }

    buildTypes {
        release {
            optimization {
                enable = true
            }
            shrinkResources true
            //minifyEnabled true (used before 9.3.0 for R8)
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'G:/mnt/bc/mydev/work/j2me/games/All_Android.pro'
        }
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_21
        targetCompatibility JavaVersion.VERSION_21
    }
    namespace 'org.allbinary.game.gd.threed.<name>'
}

dependencies {
    //implementation "androidx.core:core:1.17.0"
}